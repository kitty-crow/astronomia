  "scripts": {
    "clean": "rimraf dist coverage",
    "typecheck": "tsc -p tsconfig.json",
    "check:no-js": "if find . -type f \\( -name '*.js' -o -name '*.mjs' -o -name '*.cjs' \\) -not -path './node_modules/*' -not -path './dist/*' | grep -q .; then echo 'JavaScript source files remain' >&2; exit 1; fi",
    "lint": "npm run typecheck && npm run check:no-js",
    "build:esm": "tsc -p tsconfig.build.esm.json",
    "build:cjs": "tsc -p tsconfig.build.cjs.json && printf '{\"type\":\"commonjs\"}\\n' > dist/cjs/package.json",
    "build": "npm run clean && npm run build:esm && npm run build:cjs",
    "test": "node --import tsx ./node_modules/mocha/bin/mocha.js \"test/**/*.test.ts\"",
    "test:slow": "SLOWTESTS=1 npm test",
    "coverage": "rm -rf coverage && NODE_V8_COVERAGE=coverage node --import tsx ./node_modules/mocha/bin/mocha.js \"test/**/*.test.ts\"",
    "ci": "npm run lint && npm run build && npm run test:slow",
    "prepublishOnly": "npm run ci",
    "audit": "npm audit --audit-level=low"
  },
  "devDependencies": {
    "mocha": "^11.7.1",
    "rimraf": "^6.0.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "types": "./dist/esm/src/index.d.ts",
  "overrides": {
    "diff": "8.0.3",
    "glob": "13.0.6",
    "serialize-javascript": "7.0.5"
  }
}
